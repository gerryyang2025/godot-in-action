[node name="StartInfoLabel" type="Label" parent="CanvasLayer/StartScreen/Padding/Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.823529, 0.901961, 0.964706, 1)
theme_override_font_sizes/font_size = 18
text = "Goal: Eliminate all 4 sentry bots within the 90-second deployment window.\nControls: WASD / Arrows move, Space jumps, RMB or Q aims, LMB or F fires, Esc releases the cursor.\nCombat model: You start with 100 health; headshots are instantly lethal, torso hits hurt more, and leg hits hurt less.\nTactics: Use the central tower, long barriers and rear pillars to break enemy sightlines while your opening 3-second shield buys time to reposition."
autowrap_mode = 3

