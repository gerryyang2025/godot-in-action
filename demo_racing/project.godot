; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Infinite Racer"
config/description="Infinite Racer is a Godot 4.6.2 endless highway runner focused on risky overtakes, truck hijacks, and lightweight car progression."
config/tags=PackedStringArray("3d", "demo", "gdscript", "godot-in-action", "racing")
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")

[display]

