[node name="StartInfoLabel" type="Label" parent="CanvasLayer/StartScreen/Padding/Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.823529, 0.901961, 0.964706, 1)
theme_override_font_sizes/font_size = 18
text = "Side: You are the Counter-Terrorists. The robots are the Terrorists.\nRound goal: Eliminate all 4 Terrorists within the 90-second round timer.\nControls: WASD / Arrows move, Space jumps, RMB or Q aims, LMB or F fires, Z opens the radio, 1 reports enemy spotted, and 2 reports enemy down.\nCombat model: You start with 100 health; headshots are instantly lethal, torso hits hurt more, and leg hits hurt less.\nTactics: Use the central tower, long barriers and rear pillars to break enemy sightlines while your opening 3-second shield buys time to reposition."
autowrap_mode = 3

[node name="StartPromptLabel" type="Label" parent="CanvasLayer/StartScreen/Padding/Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.490196, 0.768627, 0.901961, 1)
theme_override_font_sizes/font_size = 18
text = "Press Space or Enter to join the Counter-Terrorists."
horizontal_alignment = 1

