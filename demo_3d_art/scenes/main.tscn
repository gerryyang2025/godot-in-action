[node name="StartInfoLabel" type="Label" parent="CanvasLayer/StartScreen/Padding/Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.823529, 0.901961, 0.964706, 1)
theme_override_font_sizes/font_size = 18
text = "Goal: Sync all 8 green beacons before the 90-second uplink window closes.\nThreat: Face 7 opening drones and 5 reinforcements. Patrol drones hold routes with orange rings, hunters break formation with red arrow markers and can relay a lock to nearby hunters, blockade drones sweep chokepoints with gold lane rails.\nControls: WASD / Arrows move, Space jumps, Q fires a scramble pulse on cooldown.\nSurvival: Use stacked blockers, ramps and high ledges to climb above drone lanes, then break line of sight before hunters recover. Each drone class also carries a different nearby hum to help you read pressure off-screen."
autowrap_mode = 3

